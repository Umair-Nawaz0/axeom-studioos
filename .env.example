# Axeom StudioOS Environment Variables Example
# Copy this file to .env and configure for your local/production environment

# Application Environment (development | test | production)
# In production, destructive reset endpoints (/api/database/reset) are strictly disabled
APP_ENV=development

# FastAPI Backend Port
PORT=8000

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/axeom

# Google Gemini API Configuration (Official google-genai SDK)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=2

# Frontend Next.js Public API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
